msgid "Bounced"
msgstr "Возвращён"

#: fluentcrm-contactsexport.php
msgid "Unconfirmed"
msgstr "Не подтверждён"

#: fluentcrm-contactsexport.php
msgid "Export FluentCRM Contacts"
msgstr "Экспорт контактов FluentCRM"

#: fluentcrm-contactsexport.php
msgid "Status filter (optional)"
msgstr "Фильтр по статусу (необязательно)"

#: fluentcrm-contactsexport.php
msgid "All contacts"
msgstr "Все контакты"

#: fluentcrm-contactsexport.php
msgid "CSV separator"
msgstr "Разделитель CSV"

#: fluentcrm-contactsexport.php
msgid "⬇ Download for Excel (CSV)"
msgstr "⬇ Скачать для Excel (CSV)"

#: fluentcrm-contactsexport.php
msgid "Copy the table (paste into Excel)"
msgstr "Копировать таблицу (вставить в Excel)"

#: fluentcrm-contactsexport.php
msgid "The CSV file opens directly in Excel (double-click). For the clipboard copy, click the first empty cell in Excel, then paste (Ctrl+V)."
msgstr "CSV-файл открывается в Excel напрямую (двойной щелчок). Для копирования в буфер обмена щелкните первую пустую ячейку в Excel и вставьте (Ctrl+V)."

#: fluentcrm-contactsexport.php
msgid "Retrieving contacts…"
msgstr "Получение контактов…"

#: fluentcrm-contactsexport.php
msgid "Contacts prepared:"
msgstr "Подготовлено контактов:"

#: fluentcrm-contactsexport.php
msgid "Contacts copied:"
msgstr "Скопировано контактов:"

#: fluentcrm-contactsexport.php
msgid "Now paste into Excel with Ctrl+V (one cell per column)."
msgstr "Теперь вставьте в Excel с помощью Ctrl+V (одна ячейка на столбец)."

